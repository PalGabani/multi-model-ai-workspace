{
  "name": "multi-model-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:api": "backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --reload --host 127.0.0.1 --port 8000",
    "db:upgrade": "backend\\.venv\\Scripts\\python.exe -m alembic -c backend\\alembic.ini upgrade head",
    "test:unit": "backend\\.venv\\Scripts\\python.exe -m pytest backend\\tests -m \"not integration\"",
    "test:integration": "backend\\.venv\\Scripts\\python.exe -m pytest backend\\tests -m integration",
    "lint:python": "backend\\.venv\\Scripts\\ruff.exe check backend\\app backend\\tests backend\\alembic"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
